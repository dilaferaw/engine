# Copy to `.env` for local development. On Render, set these in the
# dashboard (Environment tab) instead — Render does not read `.env`.

# Optional: shared matchmaking state across multiple workers.
# Leave unset for a single instance (uses MemoryLobbyStore, in-process).
# REDIS_URL=redis://localhost:6379/0

# Comma-separated extra CORS origins. The SPA is served from the same origin
# as the API in production, so this is only needed for split deployments.
# RENDER_EXTERNAL_URL is added automatically when running on Render.
# ALLOWED_ORIGINS=https://my-frontend.example.com
